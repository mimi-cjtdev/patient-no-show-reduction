# Copy to .env and fill in. .env is git-ignored.

# Backend sheet: "google" (the live Google Sheet) or "local" (CSV files in data/sheets/, used by the tests)
BRIGHTSIDE_SHEETS_BACKEND=google
# For "google": the ID from the sheet's URL, shared (Editor) with the service account ...
BRIGHTSIDE_SPREADSHEET_ID=
# ... or an empty sheet with this name in a Drive folder shared (Editor) with the service account
BRIGHTSIDE_DRIVE_FOLDER=your-drive-folder-id
BRIGHTSIDE_SPREADSHEET_NAME=Brightside – Backend
BRIGHTSIDE_GOOGLE_KEY=~/.brightside_google_key.json

# Email: "outbox" (write .eml files to outbox/) or "gmail" (send through Gmail SMTP)
BRIGHTSIDE_MAIL_MODE=outbox
BRIGHTSIDE_GMAIL_USER=you@gmail.com
# A Gmail app password (Google Account > Security > 2-Step Verification > App passwords), not your real password
BRIGHTSIDE_GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Send every email here instead (the demo patients are fake @example.com addresses)
BRIGHTSIDE_MAIL_REDIRECT_TO=you@gmail.com

# Where the links in emails point
BRIGHTSIDE_BASE_URL=http://localhost:5050
# Clinic time zone, e.g. America/New_York (empty = this machine's time)
BRIGHTSIDE_TZ=

# Analytics database the hourly sync writes (SQLite)
BRIGHTSIDE_DB_PATH=data/brightside.db
# Metabase running in Docker that can't see data/: the sync copies the database into this container
BRIGHTSIDE_METABASE_CONTAINER=metabase
